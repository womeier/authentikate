package authentikate:email@0.1.0;

interface sender {
    record message {
        %from: string,
        to: list<string>,
        subject: string,
        text: string,
        /// Reserved for backends with deduplication; stdout and SMTP do not deduplicate.
        idempotency-key: option<string>,
    }

    variant error {
        invalid-message(string),
        configuration(string),
        transport(string),
        /// SMTP rejection status. Server reply text is not exposed.
        rejected(u16),
    }

    /// Success means accepted by the backend, not delivered to the recipient.
    send: func(email: message) -> result<_, error>;
}

world email-provider {
    export sender;
}
