// The HTTP gateway.  Everything the host used to decide about a request --
// the request target's form, the Host and Origin policy, which path is an API
// route and which is a static asset, the method and media type, the body
// limit, and the response security headers -- is decided here, inside a
// component, and the host is left with the engine, storage preopen and configuration.
//
// The capability list is the point.  It forwards a byte
// body to `authentikate:service/api`, reads the origin policy from
// `authentikate:config/policy`, streams through `wasi:http`, and uses the
// monotonic clock to bound body reads.  It parses no
// JSON, inspects no credentials, holds no key and cannot reach one: the
// signing seed is in `authentikate:config/service`, which only the service
// imports.  The proofs in components/service/theories/Proofs.v are about
// `api`, so keeping this layer free of judgement keeps those theorems
// load-bearing.
package authentikate:gateway@0.1.0;

world gateway {
    // Parsed by the runtime, not here; see README's Trusted Computing Base.
    export wasi:http/handler@0.3.0;
    import wasi:clocks/monotonic-clock@0.3.0;

    import authentikate:service/api@0.1.0;
    import authentikate:config/policy@0.1.0;
}
