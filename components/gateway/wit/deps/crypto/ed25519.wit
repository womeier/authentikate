package authentikate:crypto@0.1.0;

/// Ed25519 signatures
///
/// Private keys stay in an instance-local component store. The host must
/// provision the same component instance with `import-key` before service
/// requests, then pass only the returned u32 handles in service configuration.
/// A fresh instance (including one created per request) must be provisioned
/// again: handles are not portable between instances and nothing is persisted.
/// The component imports nothing and does not generate keys or parse PKCS#8
/// or PEM. Key generation and any persistent storage belong to the host.
///
/// Sizes are fixed by RFC 8032 and are not parameters: a private key is 32
/// bytes (the seed), a public key is 32 bytes (the compressed point), and a
/// signature is 64 bytes.  A message may be any length.
interface ed25519 {
    variant error {
        /// The private key is not 32 bytes.
        invalid-private-key(string),
        /// The public key is not 32 bytes.
        invalid-public-key(string),
        /// The signature is not 64 bytes.
        invalid-signature(string),
        /// The handle does not name a key in this component instance.
        invalid-key,
        /// This instance has already imported its maximum of 1024 keys.
        key-store-full,
        /// The key store is unavailable after an internal failure.
        key-store-unavailable,
    }

    /// Import a 32-byte private seed and return an opaque, nonzero handle.
    ///
    /// At most 1024 imports succeed per instance, including duplicate seeds.
    /// Handles are never reused; keys live until the instance is destroyed.
    /// The host remains responsible for wiping its own copy of the seed.
    import-key: func(private-key: list<u8>) -> result<u32, error>;

    /// Return the 32-byte public key for an instance-local handle.
    public-key: func(key: u32) -> result<list<u8>, error>;

    /// Sign `message`, returning 64 bytes.
    ///
    /// Deterministic, as RFC 8032 specifies: the nonce comes from the key and
    /// the message, not from a random source.  Signing the same message with
    /// the same key twice gives the same signature.
    sign: func(
        key: u32,
        message: list<u8>,
    ) -> result<list<u8>, error>;

    /// Check `signature` over `message` under `public-key`.
    ///
    /// `false` means verification failed, including invalid point encodings.
    /// An `error` means an input had the wrong length.
    ///
    /// Verification is strict in the RFC 8032 sense: non-canonical point and
    /// scalar encodings are rejected, and so are signatures under a
    /// small-order public key or with a small-order R point. Libcrux checks
    /// canonical encodings and the signature equation; the wrapper rejects
    /// small-order points before calling it.
    verify: func(
        public-key: list<u8>,
        message: list<u8>,
        signature: list<u8>,
    ) -> result<bool, error>;
}

/// A component that exports Ed25519 and imports nothing.
world signing {
    export ed25519;
}
