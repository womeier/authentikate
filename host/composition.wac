package authentikate:web;

let argon2 = new authentikate:argon2 { ... };
let signer = new authentikate:hmac {};
let email = new authentikate:email-stdout { ... };
let storage = new authentikate:storage { ... };

// The service imports `authentikate:config/service@0.1.0` -- the signing seed,
// the issuer, the TTL and the sender -- which the host answers; `...` leaves
// it unsatisfied here so it surfaces as an import of the composed artifact.
// Its adapter calls `hmac.import-key` on that shared key itself, so no other
// composed component needs its bytes. The provisioning host still retains it.
let service = new authentikate:service {
    "authentikate:storage/accounts@0.1.0": storage["authentikate:storage/accounts@0.1.0"],
    "authentikate:crypto/argon2@0.1.0": argon2["authentikate:crypto/argon2@0.1.0"],
    "authentikate:crypto/hmac@0.1.0": signer["authentikate:crypto/hmac@0.1.0"],
    "authentikate:email/sender@0.1.0": email["authentikate:email/sender@0.1.0"],
    ...
};

// The gateway gets the service and nothing else from inside the composition.
// It used to be wired to the same Argon2 and HMAC-SHA-256 instances, because it
// assembled the `config` record the service took as an argument and that
// record held an instance-local key handle.  Now the service reads its own
// configuration, so the gateway has no crypto import to wire and no seed to
// hold: it forwards a byte body and reads the origin policy from the host.
let gateway = new authentikate:gateway {
    "authentikate:service/api@0.1.0": service["authentikate:service/api@0.1.0"],
    ...
};

export gateway["wasi:http/handler@0.3.0"];
