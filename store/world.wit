/// The world the merged core module is wrapped in: it imports the key-value
/// store and exports nothing of its own, because the HTTP surface is the
/// host's and the two endpoints are reached as plain exported functions.
///
/// The `wasi:keyvalue` package is not vendored here -- it belongs to
/// WebAssembly/wasi-keyvalue, and pinning a copy would mean maintaining a
/// copy.  Fetch it into deps/ before wrapping:
///
///   wkg wit fetch
///
/// and note the version: 0.2.0-draft is a draft, and its `bucket` was not a
/// resource one release ago.  store/adapter.wat encodes the current shape and
/// is the file to change when that moves.
package authentikate:store@0.1.0;

world rocq-store {
    import wasi:keyvalue/store@0.2.0-draft;
}
