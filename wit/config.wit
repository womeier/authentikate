// The host-to-component configuration contract.
//
// Owned by neither component: the service reads `service` and the gateway
// reads `policy`, and the split is the point. The shared HMAC key is in the
// record only the service's adapter reads, so the gateway -- which terminates
// HTTP and is the part an attacker talks to -- has no import through which a
// secret key could reach it. Before this split the gateway received the key
// and called `hmac.import-key` itself, purely to fill in a `config`
// argument the service wanted.
package authentikate:config@0.1.0;

/// What the service needs, read once per request by its adapter.
interface service {
    record settings {
        /// The 32-byte random HMAC-SHA-256 key. Handles are instance-local, so a fresh
        /// instance imports it again; it must be stable for the process or
        /// tokens minted before a restart stop validating.
        signing-key: list<u8>,
        /// Token issuer, and lifetime in seconds.
        iss: string,
        ttl: u64,
        /// Welcome-email sender.
        email-from: string,
    }

    get: func() -> settings;
}

/// What the gateway needs to decide whether to answer at all.
interface policy {
    record rules {
        /// Exactly one approved origin, when the operator configured one.
        /// Checked and normalized by the host; the gateway compares against
        /// it rather than re-parsing.
        approved-origin: option<string>,
        /// Otherwise, the authorities the host is actually listening on.  The
        /// bound port is host knowledge -- `LISTEN=127.0.0.1:0` picks it at
        /// runtime -- while the rule applied to it is the gateway's.
        approved-authorities: list<string>,
    }

    get: func() -> rules;
}
